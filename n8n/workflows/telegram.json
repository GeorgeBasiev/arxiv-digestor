    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const inputJson = item.json;\n\n  let textContent = null;\n\n  if (inputJson && inputJson.outputs && Array.isArray(inputJson.outputs) && inputJson.outputs.length > 0) {\n    const firstOutput = inputJson.outputs[0];\n    if (firstOutput && firstOutput.outputs && Array.isArray(firstOutput.outputs) && firstOutput.outputs.length > 0) {\n      const firstResult = firstOutput.outputs[0];\n      if (firstResult && firstResult.results && firstResult.results.message && typeof firstResult.results.message.text === 'string') {\n        textContent = firstResult.results.message.text;\n      } else if (firstResult && firstResult.artifacts && typeof firstResult.artifacts.message === 'string') {\n        textContent = firstResult.artifacts.message;\n      } else if (firstResult && firstResult.messages && Array.isArray(firstResult.messages) && firstResult.messages.length > 0 && typeof firstResult.messages[0].message === 'string') {\n        textContent = firstResult.messages[0].message;\n      }\n    }\n  }\n\n  if (textContent) {\n    const cleanedText = textContent.replace(/```json\\n?/g, '').replace(/```$/g, '').trim();\n    try {\n      const parsedJson = JSON.parse(cleanedText);\n      const resultsArray = parsedJson.results;\n      if (Array.isArray(resultsArray)) {\n        const paperIdObjects = resultsArray.map(obj => ({ paper_id: obj.paper_id })).filter(obj => obj.paper_id !== undefined);\n        item.json.paper_id_objects = paperIdObjects;\n      } else {\n        item.json.paper_id_objects = [];\n      }\n    } catch (e) {\n      item.json.paper_id_objects = [];\n    }\n  } else {\n    item.json.paper_id_objects = [];\n  }\n}\n\nreturn $input.all();"
      },
