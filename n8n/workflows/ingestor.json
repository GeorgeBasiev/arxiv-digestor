        "query": "SELECT p.id AS paper_id\nFROM papers p\nWHERE p.published_at >= now() - interval '2 days'\n  AND NOT EXISTS (\n    SELECT 1 FROM chunks c WHERE c.paper_id = p.id\n  )\nORDER BY p.published_at DESC\nLIMIT 50;\n",
