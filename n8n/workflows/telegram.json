    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  if (item.json && item.json.message && typeof item.json.message.text === 'string') {\n    const text = item.json.message.text;\n    const parts = text.split('\\n');\n\n    let part1 = parts[0] || '';\n    let part2 = 'Error';\n    let part3 = 'Error';\n\n    if (parts.length > 1) {\n      const potentialNumber = parts[1].trim();\n      if (/^-?\\d+$/.test(potentialNumber)) {\n        part2 = parseInt(potentialNumber, 10);\n      }\n    }\n\n    if (parts.length > 2) {\n      const potentialOption = parts[2].trim().toLowerCase();\n      if (potentialOption === 'short' || potentialOption === 'long' || potentialOption === 'bullets') {\n        part3 = potentialOption;\n      }\n    }\n\n    item.json.theme = part1;\n    item.json.k = part2;\n    item.json.kind = part3;\n\n  } else {\n    item.json.theme = '';\n    item.json.k = 'Error';\n    item.json.kind = 'Error';\n  }\n}\n\nreturn $input.all();"
      },
