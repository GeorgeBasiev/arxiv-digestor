      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst newItems = [];\n\nfor (const item of allItems) {\n  const paperIdObjects = item.json.paper_id_objects;\n\n  if (Array.isArray(paperIdObjects)) {\n    for (const paperObj of paperIdObjects) {\n      if (paperObj && typeof paperObj === 'object' && paperObj.hasOwnProperty('paper_id')) {\n        newItems.push({ json: { paper_id: paperObj.paper_id } });\n      }\n    }\n  }\n}\n\nreturn newItems;"
